# PostgreSQL connection (psycopg 3 driver). postgres:// URLs from hosts are also accepted.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/smart_roster

# Comma-separated origins allowed to call the API (frontend dev server / deployed URL)
CORS_ORIGINS=http://localhost:5173

# CP-SAT budgets. Deterministic time keeps results reproducible; wall time is a safety net
# (hitting it without a solution yields SOLVER_TIMEOUT, never INFEASIBLE).
SOLVER_DETERMINISTIC_TIME=30
SOLVER_WALL_TIME_LIMIT=60

# Days an approved comp-off credit stays usable
COMP_OFF_EXPIRY_DAYS=60
